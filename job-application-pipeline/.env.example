# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Anthropic (resume tailoring) ---
# console.anthropic.com -> Settings -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# --- Apollo.io (contact finding) ---
# app.apollo.io -> Settings -> Integrations -> API -> generate/copy your API key
APOLLO_API_KEY=

# --- Google (Gmail drafts + Sheets logging) ---
# console.cloud.google.com -> create/select a project -> APIs & Services -> Credentials
# -> Create Credentials -> OAuth client ID -> Application type: Desktop app
# Download the JSON and save it as google_oauth_client.json in this folder.
GOOGLE_OAUTH_CLIENT_FILE=google_oauth_client.json
GOOGLE_TOKEN_FILE=google_token.json

# The Google Sheet to append applications to (create a blank sheet, copy the ID
# from its URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit)
GOOGLE_SHEET_ID=

# --- Job search targeting ---
# The role title you're applying for, used to search Apollo for a matching
# hiring manager and to personalize outreach emails.
TARGET_ROLE="Software Engineer"

# --- You ---
YOUR_NAME="Ebube Okeke"
YOUR_EMAIL=gokeke05@gmail.com
MASTER_RESUME_PATH=master-resume.docx
